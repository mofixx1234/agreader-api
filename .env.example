NODE_ENV="development"
PORT="4000"
API_PREFIX="/api/v1"

# Supabase direct connection (migrations - port 5432)
DATABASE_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"

# Supabase pooled connection (runtime app/worker - port 6543)
DATABASE_POOL_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Kept for compatibility with prisma.config.ts
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"

UPLOAD_MAX_MB="100"
ALLOWED_MIME_TYPES="application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation"
STORAGE_ROOT="./storage"
# Optional: set only if this API container receives a mounted/copied front build.
# FRONTEND_DIST_DIR="./public"
PUBLIC_BASE_URL="http://81.0.220.161:4000"
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_STORAGE_BUCKET="flipbook-assets"
SUPABASE_IMAGES_BUCKET="flipbook-images"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
WORKER_ID="worker-local-1"
WORKER_POLL_MS="1500"
WORKER_LOCK_TTL_MS="120000"
JOB_MAX_ATTEMPTS="5"

# LibreOffice : requis pour Word/Excel → PDF. La valeur par défaut "soffice" suppose qu’il est dans le PATH.
# En Docker/Linux typique : SOFFICE_PATH="/usr/bin/soffice"
# Supabase fournit Postgres/Storage pas un shell avec LibreOffice : hébergez l’API + le worker sur Fly/Railway/VM avec LibreOffice dans l’image.
SOFFICE_PATH="soffice"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
